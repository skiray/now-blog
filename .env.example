# GitHub OAuth app used by the Decap CMS login at /admin.
# Create one at https://github.com/settings/developers
#   Homepage URL:               https://<your-domain>/
#   Authorization callback URL: https://<your-domain>/callback
#
# The client id is public (it is sent in the redirect), the secret is not.
# On Cloudflare Pages put both in Settings → Environment variables;
# locally, Cloudflare's local runtime picks them up from .dev.vars.

GITHUB_CLIENT_ID=Ov23liuBf0DK6It6qYJ9
GITHUB_CLIENT_SECRET=

# Optional: only needed if the site is *not* hosted on nowblog.pages.dev.
# SITE_ORIGIN is used to derive the OAuth redirect_uri (/callback).
# SITE_ORIGIN=https://example.com
