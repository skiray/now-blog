---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { useTranslations } from "../../../i18n/ui";
import { categoryLabel } from "../../../data/categories";
import { blogHref, getPostsByCategory, getCategories, slugOf } from "../../../i18n/content";
import { localeFrom, localePaths } from "../../../i18n/routing";

export async function getStaticPaths() {
  const paths: { params: Record<string, string | undefined> }[] = [];
  for (const { params } of localePaths()) {
    const locale = localeFrom(params);
    for (const category of await getCategories(locale)) {
      paths.push({ params: { ...params, category } });
    }
  }
  return paths;
}

const locale = localeFrom(Astro.params);
const t = useTranslations(locale);
const category = Astro.params.category!;
const posts = await getPostsByCategory(locale, category);
const label = categoryLabel(locale, category);
const base = blogHref(locale);
const prefix = locale === "en" ? "/en" : "";
const rssHref = `${prefix}/categories/${encodeURIComponent(category)}/rss.xml`;
const fmt = (d: Date) =>
  d.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout
  title={`${label} — ${t("brand")}`}
  description={t("cats.desc").replace("{category}", label)}
>
  <Navbar />
  <main class="section">
    <div class="container narrow">
      <h1 class="reveal">{label}</h1>
      <p class="count reveal">{posts.length} {t("cats.count")}</p>
      <a class="rss reveal" href={rssHref}>RSS</a>
      <div class="list">
        {
          posts.map((post, i) => (
            <a class="post reveal" style={`--i:${i}`} href={`${base}${slugOf(post)}/`}>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .container.narrow {
    max-width: 760px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 12px;
    background: linear-gradient(120deg, var(--accent-3), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .count {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 24px;
  }
  .list {
    display: grid;
    gap: 16px;
  }
  .post {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin-bottom: 8px;
  }
  .post h2 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .post p {
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .rss {
    display: inline-block;
    margin-bottom: 24px;
    font-size: 0.8rem;
    color: var(--accent);
    border: 1px solid var(--border);
    padding: 4px 12px;
    border-radius: 999px;
  }
  .rss:hover {
    border-color: var(--accent);
  }
</style>
